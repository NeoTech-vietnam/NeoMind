{
  "name": "workforce-live-client-driver",
  "publisher": "workforce-test",
  "version": "0.1.0",
  "displayName": "WorkForce Acceptance Driver (development only)",
  "description": "Runs one explicitly authorized ordinary prompt through the real Local chat UI commands and observes its receipts.",
  "engines": { "vscode": "^1.143.0" },
  "main": "./extension.cjs",
  "activationEvents": ["onStartupFinished"],
  "extensionKind": ["workspace"],
  "contributes": {
    "commands": [
      { "command": "workforce.acceptance.prepare", "title": "WorkForce Acceptance: Inspect (no inference)" },
      { "command": "workforce.acceptance.runOnce", "title": "WorkForce Acceptance: Run Authorized Prompt Once" },
      { "command": "workforce.acceptance.capture", "title": "WorkForce Acceptance: Capture Validation Chat" }
    ]
  }
}
