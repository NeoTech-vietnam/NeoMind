		{
			"id": "tpl-lane",
			"type": "group",
			"x": -40,
			"y": 3040,
			"width": 3960,
			"height": 2200,
			"label": "FLOW MẶC ĐỊNH · 4 mẫu có sẵn trong NeoMind (Flow studio › Run mới › chọn flow)",
			"x-nimbalyst": {
				"reference": {
					"kind": "native",
