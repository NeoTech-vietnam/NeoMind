{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./ui/src/*"
      ]
    }
  },
  "include": [
    "ui/src/**/*.ts",
    "ui/src/**/*.tsx",
    "src/domain/schema.ts"
  ]
}
