{
  "name": "workforce",
  "version": "0.2.0-alpha.1",
  "description": "WorkForce agents, V-model engineering and independently verified deliverables.",
  "type": "module",
  "bin": {
    "workforce": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vscode-host": {
      "types": "./dist/vscode-host.d.ts",
      "import": "./dist/vscode-host.js"
    }
  },
  "files": [
    "dist",
    "resources",
    "docs",
    "examples",
    "scripts",
    "extensions/vscode-model-bridge",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0 <25 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test --test-concurrency=2 test/*.test.mjs",
    "check": "npm test",
    "prepack": "node scripts/prepack.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "extension:package": "node scripts/package-extension.mjs",
    "runtime:package": "node scripts/package-runtime.mjs",
    "release:artifacts": "node scripts/package-release.mjs",
    "engine:bootstrap": "node scripts/bootstrap-engine.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeoTech-vietnam/NeoMind.git"
  },
  "keywords": [
    "agents",
    "skills",
    "mcp",
    "traceability",
    "embedded",
    "v-model"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@opencode-ai/sdk": "1.19.4",
    "ical.js": "2.2.1",
    "jsonc-parser": "3.3.1",
    "opencode-ai": "1.19.4",
    "smol-toml": "1.9.1",
    "undici": "8.12.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
