      {
        "name": "workforce_native_control",
        "toolReferenceName": "workforceRequestControl",
        "displayName": "WorkForce native control",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Inspect a public request key, recheck unchanged reviewed products after an environment correction, or explicitly resume retained findings with fresh specialists and checks. Keep the same request instead of submitting a replacement.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "request_key": {
              "type": "string",
              "pattern": "^WF-R\\d{4,}$",
              "description": "The public request key returned by WorkForce, not a record, task or assignment ID."
            },
            "action": {
              "type": "string",
              "enum": [
                "status",
                "recheck",
                "resume"
              ],
              "description": "Inspect results; recheck unchanged reviewed products after an environment correction; or explicitly continue retained professional findings through fresh specialist review and checks."
            },
            "workspace_folder": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Exact absolute open workspace folder. Optional for one local folder; required when multiple projects are open."
            }
          },
          "required": [
            "request_key",
            "action"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "workforce_native_capabilities",
        "toolReferenceName": "workforceCapabilities",
        "displayName": "WorkForce native capabilities",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Search approved pinned capability catalogs, inspect a named package, install an exact portable skill, or view current workspace skills. The host owns source approval and license verification. Optional unavailable or unsupported capabilities fall back to ordinary project tools; this never starts workers, runs hooks or installs MCP dependencies.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "search",
                "inspect",
                "install",
                "status"
              ]
            },
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "Required for search."
            },
            "source": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "description": "An approved source_name returned by discovery/status; never a URL."
            },
            "package": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$",
              "description": "Exact catalog candidate name; required for inspect/install."
            },
            "skill": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "description": "Exact SKILL.md frontmatter name; required for install or actual-content inspection."
            },
            "role": {
              "type": "string",
              "enum": [
                "WF.PM",
                "WF.SWSD",
                "WF.P-RES",
                "WF.FnD",
                "WF.Reviewer",
                "WF.Tester"
              ]
            },
            "workspace_folder": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Exact absolute open workspace folder. Optional for one local folder; required when multiple projects are open."
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        }
      },
