              "description": "Optional exact currently installed workspace skill names. The host pins the receipt and files; omission uses ordinary project tools."
            },
            "role": {
              "type": "string",
              "enum": [
                "WF.SWSD",
                "WF.P-RES",
                "WF.FnD",
                "WF.Reviewer",
                "WF.Tester"
              ]
            },
            "workspace_folder": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Exact absolute open workspace folder. Optional for one local folder; required when multiple projects are open."
            }
          },
