{
  "name": "workforce-model-bridge",
  "displayName": "WorkForce Universe",
  "publisher": "workforce",
  "version": "0.12.1",
  "description": "A request-centered V-model workspace with autonomous engineering agents, verified products and 9router controls.",
  "engines": {
    "vscode": "^1.143.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onUri",
    "onLanguageModelTool:workforce_request",
    "onLanguageModelTool:workforce_native_request",
    "onLanguageModelTool:workforce_native_role",
    "onLanguageModelTool:workforce_native_prepare",
    "onLanguageModelTool:workforce_native_control",
    "onLanguageModelTool:workforce_native_role_swsd",
    "onLanguageModelTool:workforce_native_role_p_res",
    "onLanguageModelTool:workforce_native_role_fnd",
    "onLanguageModelTool:workforce_native_role_reviewer",
    "onLanguageModelTool:workforce_native_role_tester",
    "onLanguageModelTool:workforce_native_capabilities"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Visualization",
    "Machine Learning"
  ],
  "files": [
    "extension.cjs",
    "monitor.cjs",
    "v-model-panel.cjs",
    "local-activity.cjs",
    "local-models.cjs",
    "local-delegation.cjs",
    "local-request.cjs",
    "focus-host.cjs",
    "focus-location.cjs",
    "focus-youtube.cjs",
    "focus-space.cjs",
    "resources/monitor/monitor.js",
    "resources/monitor/monitor.css",
    "resources/monitor/universe.js",
    "resources/monitor/v-model-panel.js",
    "resources/monitor/focus-space.js",
    "resources/monitor/focus-space.css",
    "README.md",
    "LICENSE.txt",
    "plugin-panel.cjs",
    "resources/monitor/plugins.js",
    "resources/monitor/plugins.css",
    "automation-panel.cjs",
    "native-validation.cjs",
    "native-dispatch.cjs",
    "controlled-workflows.cjs",
    "controlled-entry.cjs",
    "resources/monitor/controlled.js",
    "resources/monitor/controlled.css",
    "resources/monitor/automation.js",
    "resources/monitor/automation.css",
    "native-entry.cjs"
  ],
  "contributes": {
    "languageModelTools": [
      {
        "name": "workforce_request",
        "toolReferenceName": "workforceRequest",
        "displayName": "WorkForce Request",
        "userDescription": "Submit a request to WorkForce, inspect its progress, or answer a question and continue.",
        "modelDescription": "Submit the user's ordinary requirement to the exact open workspace. WorkForce owns planning, agent sessions, implementation, independent review/testing and recovery. Return the saved receipt; do not implement the accepted request separately. Use status or pause/resume/cancel with its returned workflow_id. Include answer on resume only for a pending genuine user question. Retrying submit recovers its saved identity; submit_new explicitly creates another request after the previous receipt was acknowledged. Never invent identifiers or credentials. The user request and project policy define the authorized scope.",
        "canBeReferencedInPrompt": true,
        "tags": [
          "workforce",
          "request"
        ],
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "workspace_folder"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "submit",
                "submit_new",
                "status",
                "pause",
                "resume",
                "cancel"
              ]
            },
            "workspace_folder": {
              "type": "string",
              "description": "Exact absolute local workspace folder for this request. Required to avoid mixing projects in multi-root windows."
            },
            "requirement": {
              "type": "string",
              "maxLength": 20000,
              "description": "The user's requested outcome and constraints. Use for submit or an intentional submit_new; retries of submit retain the saved intake identity."
            },
            "workflow_id": {
              "type": "string",
              "description": "An existing workflow ID returned by WorkForce. Required for pause, resume and cancel; optional for status."
            },
            "title": {
              "type": "string",
              "maxLength": 256,
              "description": "Optional short title for a new submit."
            },
            "answer": {
              "type": "string",
              "maxLength": 20000,
              "description": "The user answer to the selected request pending question; use with resume."
            },
            "question_id": {
              "type": "string",
              "maxLength": 256,
              "description": "Exact pending question ID returned by WorkForce status. Required with answer; never invent or replace it."
            }
          }
        }
      },
      {
        "name": "workforce_native_request",
        "toolReferenceName": "workforceNativeRequest",
        "displayName": "WorkForce native request",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Submit the ordinary requirement and professional software plan once. WorkForce owns valid native specialist calls, saved engineering identities, independent inspection, actual checks and acceptance. Optional plan.role_skills selects exact installed current workspace skill names per worker; omission uses ordinary project tools. Selection does not prove skill loading or use. Do not open a replacement request to retry an unfinished one.",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "requirement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "context": {
              "default": [],
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "description": "Project context path. Absolute paths inside the workspace and local file URIs are normalized by the backend."
              }
            },
            "plan": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "requirements": {
                  "minItems": 1,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "design": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "role_skills": {
                  "type": "object",
                  "properties": {
                    "WF.FnD": {
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
                        "description": "Exact installed workspace skill name; not a source path, package URL or ownership identity."
                      },
                      "uniqueItems": true
                    },
                    "WF.Reviewer": {
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
                        "description": "Exact installed workspace skill name; not a source path, package URL or ownership identity."
                      },
                      "uniqueItems": true
                    },
                    "WF.Tester": {
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
                        "description": "Exact installed workspace skill name; not a source path, package URL or ownership identity."
                      },
                      "uniqueItems": true
                    }
                  },
                  "additionalProperties": false,
                  "description": "Optional explicit installed workspace skills assigned only to the named workers, at most eight distinct names across these roles. Missing or changed selections are not silently replaced. Omit to use ordinary project tools."
                },
                "task_family": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "parameters": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  },
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                "outputs": {
                  "minItems": 1,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "description": "Product file path inside the workspace; the backend normalizes editor absolute paths or relative paths."
                  }
                },
                "checks": {
                  "minItems": 1,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "command": {
                        "minItems": 1,
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4000
                        }
                      },
                      "level": {
                        "type": "string",
                        "enum": [
                          "unit",
                          "integration",
                          "system",
                          "acceptance"
                        ]
                      }
                    },
                    "required": [
                      "title",
                      "command",
                      "level"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "summary",
                "requirements",
                "design",
                "outputs",
                "checks"
              ],
              "additionalProperties": false
            },
            "workspace_folder": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Exact absolute open workspace folder. Optional for one local folder; required when multiple projects are open."
            }
          },
          "required": [
            "requirement",
            "plan"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "workforce_native_role",
        "toolReferenceName": "workforceRoleJob",
