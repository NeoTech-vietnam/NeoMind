{
  "name": "neomind-model-bridge",
  "displayName": "NeoMind Agent Monitor",
  "publisher": "neomind",
  "version": "0.9.3",
  "description": "An agent universe with plug-in and MCP controls, Earth FocusSpace, calendar planning, ambient sound and guarded 9router model controls.",
  "engines": {
    "vscode": "^1.109.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onUri",
    "onLanguageModelTool:neomind_advance_workflow"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Visualization",
    "Machine Learning"
  ],
  "files": [
    "extension.cjs",
    "monitor.cjs",
    "focus-host.cjs",
    "focus-location.cjs",
    "focus-youtube.cjs",
    "focus-space.cjs",
    "resources/monitor/monitor.js",
    "resources/monitor/monitor.css",
    "resources/monitor/universe.js",
    "resources/monitor/focus-space.js",
    "resources/monitor/focus-space.css",
    "README.md",
    "LICENSE.txt",
    "plugin-panel.cjs",
    "resources/monitor/plugins.js",
    "resources/monitor/plugins.css",
    "automation-panel.cjs",
    "native-validation.cjs",
    "native-dispatch.cjs",
    "resources/monitor/automation.js",
    "resources/monitor/automation.css"
  ],
  "contributes": {
    "languageModelTools": [
      {
        "name": "neomind_advance_workflow",
        "toolReferenceName": "neomindAdvanceWorkflow",
        "displayName": "Advance NeoMind Workflow",
        "userDescription": "Advance the saved Local Copilot software workflow and run at most one backend-assigned specialist.",
        "modelDescription": "Coordinator only: advance an existing software-tools workflow using the actual private handle from assignment_open. The host calls NeoMind workflow_next, launches at most one exact saved native specialist, and reconciles its actual return. Never reconstruct agentName, prompt, model or task IDs. Call again for the next saved stage. Supply observation only for an actual prior native callback; omit it otherwise. Final Cornell authoring and manager_finish remain Coordinator actions.",
        "canBeReferencedInPrompt": true,
        "tags": ["neomind", "coordinator"],
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reported_assignment": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^local-report-[a-f0-9]{40}$" },
                "token": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              },
              "required": ["id", "token"]
            },
            "observation": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "packet_id": { "anyOf": [{ "type": "string", "pattern": "^(?:local-report-[a-f0-9]{40}|\\s*)$" }, { "type": "null" }] },
                    "state": { "type": "string", "enum": ["completed", "completed-without-output", "failed", "cancelled", "running", "unknown"] },
                    "observation_id": { "type": "string", "minLength": 1, "maxLength": 160 }
                  },
                  "required": ["state", "observation_id"]
                },
                { "type": "null" }
              ]
            }
          },
          "required": ["reported_assignment"]
        }
      }
    ],
    "commands": [
      {
        "command": "neomind.bridge.enable",
        "title": "NeoMind: Enable Model Bridge"
      },
      {
        "command": "neomind.bridge.disable",
        "title": "NeoMind: Disable Model Bridge"
      },
      {
        "command": "neomind.monitor.open",
        "title": "NeoMind: Open Agent Map"
      },
      {
        "command": "neomind.plugins.open",
        "title": "NeoMind: Manage Plug-ins"
      },
      {
        "command": "neomind.automation.open",
        "title": "NeoMind: Open Automation Library"
      },
      {
        "command": "neomind.validation.copilot",
        "title": "NeoMind: Validate Native Copilot Workflow"
      }
    ],
    "configuration": {
      "title": "NeoMind",
      "properties": {
        "neomind.bridge.runtimePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to a trusted NeoMind package directory containing package.json and built dist. Read only from User settings."
        }
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NeoTech-vietnam/NeoMind.git"
  }
}
